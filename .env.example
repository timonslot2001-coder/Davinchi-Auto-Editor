# Copy to .env and fill in. Never share this file.
# --- Instagram (Creator account linked to a Facebook page; Meta developer app) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# --- TikTok (developer app with Content Posting API, scope video.upload) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# filled in automatically by: autoedit tiktok-login
TIKTOK_REFRESH_TOKEN=
# --- Muapi.ai (AI shots, pay-as-you-go): Dashboard → API Keys ---
MUAPI_KEY=
# --- AutoEdit Studio in Docker on another computer (laptop): only these three are needed there ---
# Address of the Resolve PC's worker, as shown by start-worker-for-laptop.bat on that PC:
AEV_WORKER_URL=
# The token shown by start-worker-for-laptop.bat (on the Resolve PC it is made automatically):
AEV_WORKER_TOKEN=
# Optional: 0.0.0.0 makes the website reachable from your phone in the same wifi (there is no login).
STUDIO_BIND=127.0.0.1
