 "rules": [
  {
   "id": "RULE_COLD_OPEN",
   "trigger": "video start",
   "response": "2-11 very short shots (0.1-0.4 s) before or around the title",
   "timing": "first 0.3-1.3 s; first-fifth median shot 0.36 s",
   "evidence": [
    "R04 0.00-1.29 (11 shots)",
    "R17 0.00-0.74",
    "R06 0.00-1.07",
    "R12"
   ],
   "psychology": "obs: shortest shots of the video are at the start. interp: a rapid visual 'drum roll' hooks attention before the scroll decision",
   "do_not_apply_when": "footage has fewer than ~8 usable detail shots, or the user asks for a calm opener (U2/R16 style)",
   "confidence": "high"
  },
  {
   "id": "RULE_TITLE",
   "trigger": "after the cold open, on the first strong establishing shot of the place/topic",
   "response": "D_TITLE in the video's accent colour, hard cut in/out",
   "timing": "in at 0-3 s (median 0.54 s), hold 0.33-4.53 s (median 1.26 s)",
   "evidence": [
    "R02 0.64",
    "R04 1.29",
    "R17 0.74",
    "R06 1.62",
    "R16 0.00"
   ],
   "psychology": "obs: 11/17 refs name the place/topic once. interp: orientation + branding moment that pays off the hook",
   "do_not_apply_when": "no clear single place/topic; never repeat the title later",
   "confidence": "high"
  },
  {
   "id": "RULE_DECELERATE",
   "trigger": "second half of the edit",
   "response": "lengthen shots gradually (+~50 % vs the opening) and end on the longest/most scenic shot",
   "timing": "by fifth: 0.36 / 0.44 / 0.50 / 0.55 / 0.54 s",
   "evidence": [
    "R04 17-26 s",
    "R08 24.4-29.2",
    "R16"
   ],
   "psychology": "obs: measured pacing curve. interp: viewers get a resolving 'exhale' and the last image lingers",
   "do_not_apply_when": "loop-style edits",
   "confidence": "high"
  },
  {
   "id": "RULE_FLASH",
   "trigger": "change of place/scene or an energy accent in the music",
   "response": "T_FLASH: one white frame between the shots",
   "timing": "exactly 1 frame (2 at most)",
   "evidence": [
    "R02-C11",
    "R02-C13",
    "R05 7.11/7.47",
    "R12"
   ],
   "psychology": "obs: 17 % of transitions. interp: a camera-shutter 'blink' that marks a new beat of the story without slowing it",
   "do_not_apply_when": "two flashes within ~1 s, or into/out of a title frame",
   "confidence": "high"
  },
  {
   "id": "RULE_WHIP",
   "trigger": "outgoing shot already pans/moves",
   "response": "T_WHIP: 3-6 frames directional blur continuing the motion",
   "timing": "at the cut",
   "evidence": [
    "R12-C38",
    "R02-C06",
    "R14"
   ],
   "psychology": "obs: 12 % of transitions, strongest in R12/R14. interp: carries momentum across the cut so fast sequences feel continuous",
   "do_not_apply_when": "static shots on both sides",
   "confidence": "medium"
  },
  {
   "id": "RULE_CARD_SERIES",
   "trigger": "a sub-sequence of 3-6 related shots (one location, one activity)",
   "response": "D_CARD_WHITE for the whole series",
   "timing": "hard in/out; inner shots 0.2-1.0 s",
   "evidence": [
    "RA 6.50-11.15",
    "R05 9.48-10.81",
    "R05 12.41-13.91"
   ],
   "psychology": "obs: 3 refs. interp: shifts texture to a 'photo album' chapter and resets attention mid-video",
   "do_not_apply_when": "fewer than 3 shots; more than twice per video",
   "confidence": "medium-high"
  },
  {
   "id": "RULE_BW",
   "trigger": "a single reflective or contrast moment",
   "response": "D_BW on one shot, often entered with T_FLASH",
   "timing": "0.5-1 s",
   "evidence": [
